    let currentIndex = 0;
    const answers = {}; // key: question index, value: array of selected option indices

    const questionContainer = document.getElementById("question-container");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const submitBtn = document.getElementById("submit-btn");
    const resultsDiv = document.getElementById("results");

    function renderQuestion(index) {
      const q = questions[index];
      questionContainer.innerHTML = "";

      const header = document.createElement("div");
      header.className = "question-header";

      const number = document.createElement("div");
      number.className = "question-number";
      number.textContent = `Question ${index + 1}`;
      header.appendChild(number);

      const progress = document.createElement("div");
      progress.className = "progress";
      progress.textContent = `Q${index + 1} of ${questions.length}`;
      header.appendChild(progress);

      questionContainer.appendChild(header);

      const text = document.createElement("div");
      text.className = "question-text";
      text.textContent = q.text;
      questionContainer.appendChild(text);

      const optionsDiv = document.createElement("div");
      optionsDiv.className = "options";

      const saved = answers[index] || [];

      q.options.forEach((opt, optIndex) => {
        const id = `q${index}_opt${optIndex}`;
        const label = document.createElement("label");
        const input = document.createElement("input");
        input.type = q.type === "single" ? "radio" : "checkbox";
        input.name = `q${index}`;
        input.value = optIndex;
        input.id = id;

        if (saved.includes(optIndex)) {
          input.checked = true;
        }

        input.addEventListener("change", () => {
          if (q.type === "single") {
            answers[index] = [optIndex];
          } else {
            const current = answers[index] || [];
            if (input.checked) {
              if (!current.includes(optIndex)) current.push(optIndex);
            } else {
              const pos = current.indexOf(optIndex);
              if (pos !== -1) current.splice(pos, 1);
            }
            answers[index] = current;
          }
        });

        label.htmlFor = id;
        label.appendChild(input);
        label.appendChild(document.createTextNode(opt));
        optionsDiv.appendChild(label);
      });

      questionContainer.appendChild(optionsDiv);

      prevBtn.disabled = index === 0;
      nextBtn.disabled = index === questions.length - 1;
    }

    prevBtn.addEventListener("click", () => {
      if (currentIndex > 0) {
        currentIndex--;
        renderQuestion(currentIndex);
      }
    });

    nextBtn.addEventListener("click", () => {
      if (currentIndex < questions.length - 1) {
        currentIndex++;
        renderQuestion(currentIndex);
      }
    });

    submitBtn.addEventListener("click", () => {
      let correctCount = 0;
      resultsDiv.innerHTML = "";

      questions.forEach((q, index) => {
        const selected = answers[index] || [];
        const correct = q.correctIndices.slice().sort();
        const chosen = selected.slice().sort();

        const isCorrect =
          correct.length === chosen.length &&
          correct.every((v, i) => v === chosen[i]);

        if (isCorrect) correctCount++;

        const item = document.createElement("div");
        item.className = "result-item";

        const status = document.createElement("div");
        status.className = isCorrect ? "correct" : "incorrect";
        status.textContent = `Q${index + 1}: ${isCorrect ? "Correct" : "Incorrect"}`;
        item.appendChild(status);

        const yourAns = document.createElement("div");
        const yourText =
          selected.length === 0
            ? "Your answer: (no selection)"
            : "Your answer: " +
              selected.map(i => q.options[i]).join(", ");
        yourAns.textContent = yourText;
        item.appendChild(yourAns);

        const correctAns = document.createElement("div");
        correctAns.textContent =
          "Correct answer: " +
          q.correctIndices.map(i => q.options[i]).join(", ");
        item.appendChild(correctAns);

        const expl = document.createElement("div");
        expl.className = "explanation";
        expl.textContent = "Explanation: " + q.explanation;
        item.appendChild(expl);

        resultsDiv.appendChild(item);
      });

      const scorePercent = Math.round((correctCount / questions.length) * 100);
      const scoreHeader = document.createElement("div");
      scoreHeader.className = "score";
      scoreHeader.textContent =
        `Score: ${correctCount} / ${questions.length} (${scorePercent}%)`;
      resultsDiv.insertBefore(scoreHeader, resultsDiv.firstChild);

      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    renderQuestion(currentIndex);
  </script>
